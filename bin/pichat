#!/usr/bin/env sh
# PiChat launcher — runs pi against the PiChat config directory. All arguments
# are passed through to pi untouched, so the CLI is identical to pi
# (install/remove/list/config/auth/update … all work the same). The agent dir
# is what separates the two harnesses.
set -eu

# Resolve the PiChat config directory:
#   1. $PI_PICHAT_DIR if set (explicit override)
#   2. $PI_CODING_AGENT_DIR if set (honor an existing override)
#   3. default: ~/.pi/pichat
if [ -n "${PI_PICHAT_DIR:-}" ]; then
  PICHAT_DIR=$PI_PICHAT_DIR
elif [ -n "${PI_CODING_AGENT_DIR:-}" ]; then
  PICHAT_DIR=$PI_CODING_AGENT_DIR
else
  PICHAT_DIR=$HOME/.pi/pichat
fi

# Convenience: `pichat update` pulls the installed config and updates pi packages.
case "${1:-}" in
  update)
    shift
    if [ -d "$PICHAT_DIR/.git" ]; then
      echo "pichat: pulling $PICHAT_DIR"
      git -C "$PICHAT_DIR" pull --ff-only
    else
      echo "pichat: $PICHAT_DIR is not a git clone; update the source repo and re-run install.sh" >&2
    fi
    PI_CODING_AGENT_DIR="$PICHAT_DIR" exec pi update "$@"
    ;;
esac

# Resources are discovered exactly like in regular pi: the PiChat config dir
# ($PICHAT_DIR), the home-level ~/.agents/skills, and project .agents dirs
# when trusted. Your other harness's agent dir (~/.pi/agent) is separate and
# never touched. Because we never prepend flags, pi's first argument is never
# altered and package commands dispatch exactly like with pi itself.
PI_CODING_AGENT_DIR="$PICHAT_DIR" exec pi "$@"
